# Copy to backend/.env and fill in. Generate JWT_SECRET_KEY and
# ADMIN_PASSWORD_HASH with: uv run python scripts/generate_secrets.py

# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (local development with `docker compose up -d postgres`)
DATABASE_URL=postgresql+asyncpg://wedding:wedding@localhost:5432/wedding
POSTGRES_USER=wedding
POSTGRES_PASSWORD=wedding
POSTGRES_DB=wedding

# Where guests open the site (used in QR codes), and the origins allowed to call the API
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
# Bcrypt hash of the password for the "admin" user, created on first start.
# Wrap it in single quotes: the hash contains "$".
ADMIN_PASSWORD_HASH=

# Rate limiting
RATE_LIMIT_RSVP=10/day
RATE_LIMIT_ADMIN_LOGIN=5/minute

# Only accept RSVPs from phone numbers on the invited guest list
REQUIRE_INVITED_GUEST_VALIDATION=false

# Email notifications (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Wedding RSVP
ADMIN_EMAIL=
