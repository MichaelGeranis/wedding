# Demo defaults so `docker compose up` works with no setup.
#
# These values are PUBLIC: anyone who reads this repository knows them.
# They are fine on your own machine (the ports are bound to 127.0.0.1) and
# nowhere else. Override any of them in backend/.env, which is loaded after
# this file. The API refuses to start in production with the demo JWT secret.
ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_USER=wedding
POSTGRES_PASSWORD=wedding
POSTGRES_DB=wedding

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

JWT_SECRET_KEY=demo-only-jwt-secret-do-not-use-in-production
# Admin login: username "admin", password "demo-admin"
ADMIN_PASSWORD_HASH='$2b$12$K4dfPv806QIG2ThBbFFqC.QykovDu4aUa0pgfJ8tYyX8HyIhJZNCy'

RATE_LIMIT_RSVP=10/day
RATE_LIMIT_ADMIN_LOGIN=5/minute
